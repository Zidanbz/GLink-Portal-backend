NODE_ENV=production
HOST=127.0.0.1
PORT=5101
TZ=Asia/Makassar
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=glink_app
DB_PASSWORD=REPLACE_ON_SERVER
DB_NAME=globallink_approval
CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
UPLOAD_DIR=/srv/glink-portal/shared/uploads

# Existing deployment remains MySQL by default. Vercel: set DATA_PROVIDER=firebase.
DATA_PROVIDER=mysql
# Vercel/Firebase: random secret >=32 characters, same value in frontend/backend.
BACKEND_API_SECRET=
# Firebase Admin SDK: SERVER ONLY, never NEXT_PUBLIC_. No credentials in Git.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
