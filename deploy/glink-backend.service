[Unit]
Description=GLink Portal Backend
After=network.target docker.service

[Service]
Type=simple
User=glink
Group=glink
WorkingDirectory=/srv/glink-portal/current/GLink Portal-Backend
EnvironmentFile=/srv/glink-portal/shared/backend.env
ExecStart=/opt/glink-node/current/bin/node server.js
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
